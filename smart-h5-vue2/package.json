{
  "name": "smart-web-app",
  "version": "1.0.0",
  "author": "tce",
  "scripts": {
    "serve": "cross-env BUILD_MODULE=h5 vue-cli-service serve",
    "build": "cross-env BUILD_MODULE=h5 vue-cli-service build --dest dist-h5",
    "lint": "vue-cli-service lint",
    "test:ui-contracts": "node scripts/check-ui-contracts.js",
    "test:tooling-contracts": "node scripts/check-tooling-contracts.js",
    "test": "pnpm run test:tooling-contracts && pnpm run test:ui-contracts",
    "fix": "node_modules/.bin/standard --fix"
  },
  "dependencies": {
    "@tce/tce-components": "1.0.0",
    "@tce/tce-font": "1.0.0",
    "@tce/tce-util": "1.0.0",
    "autoprefixer": "^10.0.1",
    "axios": "^0.19.0",
    "core-js": "^3.7.0",
    "crypto-js": "^4.0.0",
    "cube-ui": "^1.12.44",
    "echarts": "4.4.0",
    "emitter.js": "^0.1.2",
    "js-file-download": "^0.4.12",
    "pdfjs-dist": "2.6.347",
    "swiper": "^5.4.1",
    "vconsole": "^3.15.1",
    "vue": "2.6.11",
    "vue-awesome-swiper": "^4.1.1",
    "vue-pdf": "^4.3.0",
    "vue-resize-sensor": "^2.0.0",
    "vue-router": "3.1.3",
    "vuex": "3.1.2",
    "weixin-js-sdk": "^1.6.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^3.9.0",
    "@vue/cli-plugin-eslint": "^3.9.0",
    "@vue/cli-service": "^3.9.0",
    "@vue/eslint-config-standard": "^4.0.0",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^8.4.1",
    "babel-plugin-component": "^1.1.1",
    "cache-loader": "^2.0.1",
    "chai": "^4.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^1.0.1",
    "eslint": "^5.16.0",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-vue": "^5.0.0",
    "file-loader": "^3.0.1",
    "husky": "^3.0.2",
    "js-conditional-compile-loader": "^1.0.14",
    "lint-staged": "^9.2.1",
    "postcss": "^8.1.4",
    "postcss-loader": "^4.0.4",
    "raw-loader": "^3.1.0",
    "sass": "^1.89.2",
    "sass-loader": "^10.5.2",
    "service-mocker": "^2.1.2",
    "service-mocker-polyfills": "^1.1.4",
    "standard": "^13.1.0",
    "svgo": "1.3.0",
    "thread-loader": "^2.1.3",
    "url-loader": "^1.1.2",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.6.11",
    "worker-loader": "^2.0.0"
  },
  "license": "",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "vue-cli-service lint",
      "git add"
    ],
    "*.vue": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "standard": {
    "ignore": [
      "**/dist-monitor/",
      "**/dist-h5/",
      "**/dist/",
      "**/public/",
      "/src/router/",
      "/src/mock",
      "/public/",
      "/src/util/"
    ],
    "globals": [
      "window",
      "FormData",
      "import",
      "tce"
    ]
  },
  "repository": ""
}
