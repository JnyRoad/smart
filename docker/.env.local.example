# Copy this file to .env.local or .env before running docker compose.
# Do not commit real credentials.

DOCKER_PLATFORM=linux/amd64
APP_ENV=local
SMART_DOCKER_ENV_FILE=.env.local

# Nacos uses the same namespace/group shape observed in production.
NACOS_GROUP=dev
NACOS_NAMESPACE=eda914a9-b100-427b-9d37-4d7da89b841f
NACOS_NAMESPACE_NAME=smart-local-dev
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=128m

# Host ports
NACOS_HOST_PORT=8848
SMART_REDIS_HOST_PORT=6379
SMART_ZOOKEEPER_HOST_PORT=2181
SMART_KAFKA_HOST_PORT=9092
SMART_GATEWAY_HOST_PORT=9990
SMART_AUTH_HOST_PORT=3000
SMART_UPMS_HOST_PORT=4000
SMART_APP_HOST_PORT=6020
SMART_PLATFORM_HOST_PORT=6030
SMART_DISPATCHER_HOST_PORT=8082
SMART_BRIDGE_ISC_HOST_PORT=6060
SMART_SCHEDULE_HOST_PORT=7070
SMART_UI_HOST_PORT=8080
SMART_H5_HOST_PORT=8081

# Core real database connection. Service-specific DB variables fall back here.
SMART_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
SMART_DB_USERNAME=replace_me
SMART_DB_PASSWORD=replace_me

# Optional core service DB overrides. Uncomment only when a service must use a
# different database from SMART_DB_*.
# SMART_AUTH_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_AUTH_DB_USERNAME=replace_me
# SMART_AUTH_DB_PASSWORD=replace_me
# SMART_UPMS_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_UPMS_DB_USERNAME=replace_me
# SMART_UPMS_DB_PASSWORD=replace_me
# SMART_APP_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_APP_DB_USERNAME=replace_me
# SMART_APP_DB_PASSWORD=replace_me
# SMART_PLATFORM_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_PLATFORM_DB_USERNAME=replace_me
# SMART_PLATFORM_DB_PASSWORD=replace_me
# SMART_ALGORITHM_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_ALGORITHM_DB_USERNAME=replace_me
# SMART_ALGORITHM_DB_PASSWORD=replace_me
# SMART_DATA_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_DATA_DB_USERNAME=replace_me
# SMART_DATA_DB_PASSWORD=replace_me
# SMART_SCHEDULE_DB_URL=jdbc:oracle:thin:@//REAL_DB_HOST:1521/REAL_SERVICE
# SMART_SCHEDULE_DB_USERNAME=replace_me
# SMART_SCHEDULE_DB_PASSWORD=replace_me
# SMART_BRIDGE_DB_URL=jdbc:sqlite:./database/smart_bridge.db
# SMART_BRIDGE_ISC_DB_URL=jdbc:sqlite:./database/smart_bridge.db

# External production data sources used by data/schedule jobs. The platform
# datasource falls back to SMART_DB_* unless these overrides are uncommented.
# SMART_PLATFORM_DB_DRIVER=oracle.jdbc.driver.OracleDriver
# SMART_PLATFORM_DB_URL=jdbc:oracle:thin:@//REAL_PLATFORM_DB_HOST:1521/REAL_SERVICE
# SMART_PLATFORM_DB_USERNAME=replace_me
# SMART_PLATFORM_DB_PASSWORD=replace_me
SMART_ATTENDANCE_DB_URL=jdbc:sqlserver://REAL_ATTENDANCE_HOST:1433;DatabaseName=REAL_DB
SMART_ATTENDANCE_DB_USERNAME=replace_me
SMART_ATTENDANCE_DB_PASSWORD=replace_me
SMART_BUSINESSTRIP_DB_URL=jdbc:oracle:thin:@REAL_BUSINESSTRIP_HOST:1521/REAL_SERVICE
SMART_BUSINESSTRIP_DB_USERNAME=replace_me
SMART_BUSINESSTRIP_DB_PASSWORD=replace_me
SMART_EHRVIEW_DB_URL=jdbc:sqlserver://REAL_EHR_HOST:1433;DatabaseName=REAL_DB
SMART_EHRVIEW_DB_USERNAME=replace_me
SMART_EHRVIEW_DB_PASSWORD=replace_me
SMART_DHRVIEW_DB_URL=jdbc:oracle:thin:@REAL_DHR_HOST:1521/REAL_SERVICE
SMART_DHRVIEW_DB_USERNAME=replace_me
SMART_DHRVIEW_DB_PASSWORD=replace_me
SMART_TEMPORARY_DB_URL=jdbc:sqlserver://REAL_TEMP_HOST:1433;DatabaseName=REAL_DB
SMART_TEMPORARY_DB_USERNAME=replace_me
SMART_TEMPORARY_DB_PASSWORD=replace_me
SMART_GUARD_DB_URL=jdbc:oracle:thin:@REAL_GUARD_HOST:1521/REAL_SERVICE
SMART_GUARD_DB_USERNAME=replace_me
SMART_GUARD_DB_PASSWORD=replace_me
SMART_XC_C6_DB_URL=jdbc:sqlserver://REAL_XC_C6_HOST:1433;DatabaseName=REAL_DB
SMART_XC_C6_DB_USERNAME=replace_me
SMART_XC_C6_DB_PASSWORD=replace_me

# Local Redis by default. Do not point to production Redis unless you need to
# deliberately test shared cache/lock behavior.
SMART_REDIS_HOST=smart-redis
SMART_REDIS_PORT=6379
SMART_REDIS_PASSWORD=
SMART_REDIS_DATABASE=0

# Local Kafka by default, so bridge services do not join production consumer groups.
SMART_KAFKA_BOOTSTRAP_SERVERS=smart-kafka:9092
SMART_KAFKA_CONSUMER_GROUP_ID=smart-local
SMART_KAFKA_EVENT_TOPIC=smart-local-event
SMART_KAFKA_IMAGE_TOPIC=smart-local-image
SMART_KAFKA_BRIDGE_EVENT_TOPIC=smart-local-bridge-event
SMART_KAFKA_EVENT_GROUP_ID=smart-local-event-group
SMART_KAFKA_IMAGE_GROUP_ID=smart-local-image-group
SMART_KAFKA_BRIDGE_EVENT_GROUP_ID=smart-local-bridge-event-group

# OAuth client values must exist in the real oauth_client_details table.
SMART_OAUTH_CLIENT_ID=replace_me
SMART_OAUTH_CLIENT_SECRET=replace_me
SMART_OAUTH_TOKEN_INFO_URI=http://smart-auth:3000/oauth/check_token

# Security/runtime keys externalized from code.
SMART_SECURITY_ENCODE_KEY=replace_me
SMART_AUTH_CODE_ENCODE_KEY=replace_me
SMART_DEFAULT_RESET_PASSWORD=123456
SMART_JASYPT_PASSWORD=replace_me

# ISC / Hikvision real environment. Use test people/cards/devices only.
SMART_HIK_HOST=REAL_ISC_HOST:443
SMART_HIK_APP_KEY=replace_me
SMART_HIK_APP_SECRET=replace_me
SMART_HIK_CALLBACK_URL=http://host.docker.internal:6060/bridge/handle
SMART_HIK_EVENT_SUBSCRIBE_ENABLED=false

# Bridge, HBase, and photo dependencies.
SMART_BRIDGE_C_PROCESS_URL=http://host.docker.internal:7001
SMART_BRIDGE_C_PROCESS_BRIDGE_URL=http://smart-bridge-isc:6060
SMART_DEVICE_ADMIN_BASEURL=http://host.docker.internal:7001/devicemanager/
SMART_DEVICE_ADMIN_FACEURL=http://host.docker.internal:7002/facerecognition/
SMART_HBASE_ZOOKEEPER_QUORUM=REAL_HBASE_ZK_HOST
SMART_HBASE_ZOOKEEPER_PORT=2181
SMART_HBASE_ZOOKEEPER_ZNODE=/hbase
SMART_HBASE_MAX_SIZE=10485760
SMART_STAFF_PHOTO_URL=http://REAL_STAFF_PHOTO_HOST
SMART_OBS_AK=replace_me
SMART_OBS_SK=replace_me
SMART_OBS_ENDPOINT=
SMART_OBS_BUCKET_NAME=replace_me
SMART_OBS_DIR_PATH=Photo/App/
SMART_SMB_PHOTO_DOMAIN=
SMART_SMB_PHOTO_USERNAME=replace_me
SMART_SMB_PHOTO_PASSWORD=replace_me
SMART_SMB_PHOTO_URL=smb://REAL_SMB_HOST/photo$/App

# Park/org values used by ISC sync logic.
SMART_XC_PARK_ID=5000021
SMART_HF_PARK_ID=10001
SMART_SY_PARK_ID=161
SMART_ORG_XC_HPO_INDEX_CODE=replace_me
SMART_ORG_XC_VISITOR_INDEX_CODE=replace_me
SMART_ORG_HF_INDEX_CODE=replace_me
SMART_DEVICE_MODE_ACCESS=replace_me

# Side-effect integrations. Fill only for the path you are testing.
SMART_SMS_URL=
SMART_SMS_TOKEN=
SMART_OA_STAFF_QUERY_URL=
SMART_OA_STAFF_QUERY_TOKEN=
SMART_OA_PROCESS_LEAVE_URL=
SMART_OA_PROCESS_LEAVE_TOKEN=
SMART_OA_PROCESS_LOG_URL=
SMART_OA_PROCESS_LOG_TOKEN=
SMART_SECSYSTEM_PHONE_UPDATE_URL=
SMART_SECSYSTEM_PHONE_UPDATE_TOKEN=
SMART_SECSYSTEM_LOGIN_SIGN_ON=
SMART_SECSYSTEM_LOGIN_SIGN_TOKEN=
SMART_SECSYSTEM_PASSWORD_UPDATE_URL=
SMART_SECSYSTEM_PASSWORD_UPDATE_TOKEN=
SMART_LOCK_BASE_URL=http://host.docker.internal:8001
SMART_LOCK_SEND_URL=http://host.docker.internal:8001/person/dormitory
SMART_ADMITTANCE_REMOTE_URL=
SMART_ADMITTANCE_SMS_URL=
SMART_RELEASE_SMS_URL=
SMART_SETTLEMENT_CHECK_TOKEN=
SMART_VISITOR_HF_TOKEN=
SMART_VISITOR_REMOTE_URL=

# App/H5 third-party integrations. Fill only when testing those paths.
SMART_MAIL_USERNAME=
SMART_MAIL_PASSWORD=
SMART_OCR_USERNAME=
SMART_OCR_URL=
SMART_FACE_FORGET_PASSWORD=0.7
SMART_YHT_APP_KEY=
SMART_YHT_APP_SECRET=
SMART_YHT_ACCESS_TOKEN_URL=
SMART_YHT_USER_ID_URL=
SMART_YHT_USER_INFO_URL=
SMART_WECHAT_APP_ID=
SMART_WECHAT_APP_SECRET=
SMART_WECHAT_OAUTH2_URL=
SMART_WECHAT_XC_USER_INFO_URL=
SMART_WECHAT_XC_APP_ID=
SMART_WECHAT_XC_APP_SECRET=
SMART_WECHAT_XC_BASE_URL=
SMART_ICBC_H5_EACCOUNT_URL=
SMART_UNI_PUSH_APP_ID=
SMART_UNI_PUSH_APP_KEY=
SMART_UNI_PUSH_MASTER_SECRET=
SMART_UNI_PUSH_URL=

# Local safety switches. Keep every ISC scheduled job disabled until you enable
# one specific test job in Nacos or this env file.
SMART_JOB_ISC_DOWN_CARD=false
SMART_JOB_ISC_AUTH_PROCESS_HANDLE=false
SMART_JOB_ISC_AUTH_RESULT_HANDLE=false
SMART_JOB_ISC_AUTO_AUTH_RESULT_HANDLE=false
SMART_JOB_ISC_DEL_CARD=false
SMART_JOB_ISC_DEVICE_SYNC=false
SMART_JOB_ISC_PERSON_FACE_RETRY=false
SMART_JOB_ISC_DEVICE_OFFLINE_HANDLER=false
