CREATE TABLE sys_user (
    user_id NUMBER(10) PRIMARY KEY,
    username VARCHAR2(100 CHAR) NOT NULL UNIQUE,
    password VARCHAR2(200 CHAR) NOT NULL,
    salt VARCHAR2(100 CHAR),
    create_time TIMESTAMP(6), update_time TIMESTAMP(6),
    del_flag VARCHAR2(2 CHAR) NOT NULL,
    lock_flag VARCHAR2(2 CHAR) NOT NULL,
    phone VARCHAR2(40 CHAR), avatar VARCHAR2(500 CHAR), dept_id NUMBER(10),
    wx_openid VARCHAR2(200 CHAR), qq_openid VARCHAR2(200 CHAR), full_name VARCHAR2(100 CHAR)
);
CREATE TABLE sys_role (
    role_id NUMBER(10) PRIMARY KEY, role_name VARCHAR2(100 CHAR) NOT NULL,
    role_code VARCHAR2(100 CHAR) NOT NULL, role_desc VARCHAR2(200 CHAR) NOT NULL,
    ds_type NUMBER(10) NOT NULL, ds_scope VARCHAR2(1000 CHAR),
    create_time TIMESTAMP(6), update_time TIMESTAMP(6), del_flag VARCHAR2(2 CHAR) NOT NULL
);
CREATE TABLE sys_menu (
    menu_id NUMBER(10) PRIMARY KEY, name VARCHAR2(100 CHAR) NOT NULL, permission VARCHAR2(150 CHAR),
    parent_id NUMBER(10) NOT NULL, icon VARCHAR2(100 CHAR), component VARCHAR2(300 CHAR), sort NUMBER(10),
    type VARCHAR2(2 CHAR), keep_alive VARCHAR2(2 CHAR), create_time TIMESTAMP(6), update_time TIMESTAMP(6),
    del_flag VARCHAR2(2 CHAR) NOT NULL, path VARCHAR2(300 CHAR)
);
CREATE TABLE sys_user_role (user_id NUMBER(10) NOT NULL, role_id NUMBER(10) NOT NULL, PRIMARY KEY (user_id, role_id));
CREATE TABLE sys_role_menu (role_id NUMBER(10) NOT NULL, menu_id NUMBER(10) NOT NULL, PRIMARY KEY (role_id, menu_id));
CREATE TABLE sys_user_park (user_id NUMBER(10) NOT NULL, park_id NUMBER(10) NOT NULL, create_time TIMESTAMP(6), PRIMARY KEY (user_id, park_id));
CREATE TABLE sys_dict (
    id NUMBER(10) PRIMARY KEY, value VARCHAR2(300 CHAR), label VARCHAR2(300 CHAR), type VARCHAR2(100 CHAR),
    description VARCHAR2(500 CHAR), sort NUMBER(10), create_time TIMESTAMP(6), update_time TIMESTAMP(6),
    remarks VARCHAR2(1000 CHAR), del_flag VARCHAR2(2 CHAR)
);
CREATE TABLE sys_oauth_client_details (
    client_id VARCHAR2(256 CHAR) PRIMARY KEY, client_secret VARCHAR2(256 CHAR) NOT NULL,
    resource_ids VARCHAR2(256 CHAR), scope VARCHAR2(256 CHAR) NOT NULL, authorized_grant_types VARCHAR2(256 CHAR),
    web_server_redirect_uri VARCHAR2(256 CHAR), authorities VARCHAR2(256 CHAR), access_token_validity NUMBER(10),
    refresh_token_validity NUMBER(10), additional_information CLOB, autoapprove VARCHAR2(256 CHAR)
);
-- UPMS 客户端授权范围变更的撤销待办；与当前服务实体和 Mapper 保持一致，避免演示调度持续报错。
CREATE TABLE SYS_OAUTH_CLIENT_REVOKE_TASK (
    TASK_ID VARCHAR2(36 CHAR) NOT NULL,
    CLIENT_ID VARCHAR2(256 CHAR) NOT NULL,
    CREATE_TIME TIMESTAMP(6) DEFAULT SYSTIMESTAMP NOT NULL,
    NEXT_RETRY_AT TIMESTAMP(6) DEFAULT SYSTIMESTAMP NOT NULL,
    CONSTRAINT PK_SYS_OAUTH_CLIENT_REVOKE PRIMARY KEY (TASK_ID)
);
CREATE INDEX IDX_OAUTH_REVOKE_PENDING
    ON SYS_OAUTH_CLIENT_REVOKE_TASK (NEXT_RETRY_AT, CREATE_TIME, TASK_ID);
CREATE INDEX IDX_OAUTH_REVOKE_CLIENT
    ON SYS_OAUTH_CLIENT_REVOKE_TASK (CLIENT_ID, CREATE_TIME, TASK_ID);
CREATE TABLE sys_route_conf (
    id NUMBER(10) PRIMARY KEY, route_id VARCHAR2(100 CHAR), route_name VARCHAR2(100 CHAR),
    predicates CLOB, filters CLOB, uri VARCHAR2(500 CHAR), order_number NUMBER(10),
    create_time TIMESTAMP(6), update_time TIMESTAMP(6), del_flag VARCHAR2(2 CHAR)
);

CREATE TABLE smt_staff (
    id NUMBER(19) PRIMARY KEY, seq_id NUMBER(10), name VARCHAR2(100 CHAR), badge VARCHAR2(100 CHAR) UNIQUE,
    job_id VARCHAR2(100 CHAR), job_name VARCHAR2(100 CHAR), comp_id VARCHAR2(100 CHAR), comp_name VARCHAR2(200 CHAR),
    dep_abbr VARCHAR2(100 CHAR), dep_id VARCHAR2(100 CHAR), dep_name VARCHAR2(200 CHAR), jche_id VARCHAR2(100 CHAR),
    jche_name VARCHAR2(100 CHAR), welfare_level VARCHAR2(100 CHAR), certno VARCHAR2(100 CHAR), sex NUMBER(10), age NUMBER(10),
    birth VARCHAR2(40 CHAR), phone VARCHAR2(40 CHAR), wechat VARCHAR2(100 CHAR), email VARCHAR2(200 CHAR),
    home_address VARCHAR2(500 CHAR), live_address VARCHAR2(500 CHAR), certno_pic_id VARCHAR2(100 CHAR), face_pic_id VARCHAR2(100 CHAR),
    status NUMBER(10), create_time TIMESTAMP(6), dormitory_status NUMBER(10), police VARCHAR2(100 CHAR),
    valid_date_fm TIMESTAMP(6), valid_date TIMESTAMP(6), e_id NUMBER(10), emp_type NUMBER(10), report_to VARCHAR2(100 CHAR),
    application_id NUMBER(19), pzid NUMBER(10), dispatch VARCHAR2(100 CHAR), nation VARCHAR2(100 CHAR),
    residentaddress VARCHAR2(500 CHAR), lea_date TIMESTAMP(6), lea_type VARCHAR2(100 CHAR), pqcompany VARCHAR2(200 CHAR)
);
CREATE TABLE smt_organize_relation (
    id NUMBER(19) PRIMARY KEY, user_id NUMBER(10), comp_name VARCHAR2(200 CHAR), park_id NUMBER(10),
    user_name VARCHAR2(100 CHAR), source NUMBER(10), comp_id VARCHAR2(100 CHAR), create_time TIMESTAMP(6), comp_type NUMBER(10)
);
-- 仅满足平台启动时的只读园区查询；演示环境不插入车场，避免触发任何历史设备调用。
CREATE TABLE smt_park (
    id NUMBER(10) PRIMARY KEY, park_name VARCHAR2(200 CHAR) NOT NULL,
    park_longitude NUMBER(18, 8) NOT NULL, park_latitude NUMBER(18, 8) NOT NULL,
    park_address VARCHAR2(500 CHAR), radius NUMBER(10), park_phone VARCHAR2(40 CHAR), bridge_url VARCHAR2(500 CHAR),
    area NUMBER(10), work_shop_num NUMBER(10), dining_room_num NUMBER(10)
);

CREATE TABLE smt_admittance_apply (
    id NUMBER(19) PRIMARY KEY, park_id NUMBER(10), visitor_name VARCHAR2(100 CHAR), visitor_photo_id VARCHAR2(100 CHAR),
    visitor_phone VARCHAR2(40 CHAR), cert_no VARCHAR2(100 CHAR), status NUMBER(10), start_time TIMESTAMP(6), end_time TIMESTAMP(6),
    receptionist_badge VARCHAR2(100 CHAR), receptionist_name VARCHAR2(100 CHAR), receptionist_phone VARCHAR2(40 CHAR),
    is_send NUMBER(10), create_time TIMESTAMP(6), remark VARCHAR2(1000 CHAR), sms_code VARCHAR2(20 CHAR), company VARCHAR2(200 CHAR),
    person_type NUMBER(10), cause NUMBER(10), thing NUMBER(10), process_id VARCHAR2(100 CHAR), device_status NUMBER(10),
    is_vehicle NUMBER(10), union_id VARCHAR2(200 CHAR), permit_factory_type VARCHAR2(500 CHAR), area_type VARCHAR2(500 CHAR),
    permit_area VARCHAR2(1000 CHAR), permit_old_area VARCHAR2(1000 CHAR), apply_type NUMBER(10), isc_submit_batch NUMBER(19)
);
CREATE TABLE smt_admittance_fellow (
    id NUMBER(19) PRIMARY KEY, visitor_id NUMBER(19) NOT NULL, fellow_name VARCHAR2(100 CHAR), fellow_photo_id VARCHAR2(100 CHAR),
    cert_no VARCHAR2(100 CHAR), cert_type NUMBER(10), front_photo_id VARCHAR2(100 CHAR), native_place VARCHAR2(200 CHAR), is_main NUMBER(10)
);

CREATE TABLE SMT_CLIENT_RELEASE (
    RELEASE_ID VARCHAR2(128 CHAR) NOT NULL, STATUS VARCHAR2(32 CHAR) NOT NULL, RELEASE_VERSION NUMBER(19) NOT NULL,
    SNAPSHOT_JSON CLOB NOT NULL, CREATED_AT TIMESTAMP(6) NOT NULL, UPDATED_AT TIMESTAMP(6) NOT NULL,
    CONSTRAINT SMT_CREL_PK PRIMARY KEY (RELEASE_ID), CONSTRAINT SMT_CREL_VER_CK CHECK (RELEASE_VERSION > 0)
);
CREATE TABLE SMT_CLIENT_RELEASE_EVENT (
    EVENT_ID VARCHAR2(128 CHAR) NOT NULL, RELEASE_ID VARCHAR2(128 CHAR) NOT NULL, RELEASE_VERSION NUMBER(19) NOT NULL,
    ACTION VARCHAR2(32 CHAR) NOT NULL, ACTOR_ID VARCHAR2(128 CHAR) NOT NULL, OCCURRED_AT TIMESTAMP(6) NOT NULL, EVENT_JSON CLOB NOT NULL,
    CONSTRAINT SMT_CREL_EVT_PK PRIMARY KEY (EVENT_ID), CONSTRAINT SMT_CREL_EVT_REL_FK FOREIGN KEY (RELEASE_ID) REFERENCES SMT_CLIENT_RELEASE (RELEASE_ID),
    CONSTRAINT SMT_CREL_EVT_VER_UK UNIQUE (RELEASE_ID, RELEASE_VERSION), CONSTRAINT SMT_CREL_EVT_VER_CK CHECK (RELEASE_VERSION > 0)
);
CREATE TABLE SMT_CLIENT_RELEASE_COMMAND (
    SERVICE_SCOPE VARCHAR2(128 CHAR) NOT NULL, ACTOR_ID VARCHAR2(128 CHAR) NOT NULL, IDEMPOTENCY_KEY VARCHAR2(200 CHAR) NOT NULL,
    REQUEST_DIGEST VARCHAR2(64 CHAR) NOT NULL, RELEASE_ID VARCHAR2(128 CHAR) NOT NULL, RESPONSE_JSON CLOB, CREATED_AT TIMESTAMP(6) NOT NULL,
    CONSTRAINT SMT_CREL_CMD_PK PRIMARY KEY (SERVICE_SCOPE, ACTOR_ID, IDEMPOTENCY_KEY), CONSTRAINT SMT_CREL_CMD_DIG_CK CHECK (LENGTH(REQUEST_DIGEST) = 64)
);
CREATE TABLE SMT_CLIENT_SUP_PRESENCE (
    PERSON_ID VARCHAR2(128 CHAR) NOT NULL, AREA_ID VARCHAR2(128 CHAR) NOT NULL, PRESENCE_STATE VARCHAR2(16 CHAR) NOT NULL,
    VERSION_NO NUMBER(19, 0) NOT NULL, UPDATED_AT TIMESTAMP(6) NOT NULL,
    CONSTRAINT PK_SCS_PRES PRIMARY KEY (PERSON_ID, AREA_ID), CONSTRAINT CK_SCS_PRES_STATE CHECK (PRESENCE_STATE IN ('UNKNOWN', 'OUTSIDE', 'INSIDE')),
    CONSTRAINT CK_SCS_PRES_VER CHECK (VERSION_NO >= 0)
);
CREATE TABLE SMT_CLIENT_SUP_VERIFY (
    VERIFICATION_ID VARCHAR2(128 CHAR) NOT NULL, OPERATOR_ID VARCHAR2(128 CHAR) NOT NULL, POST_ID VARCHAR2(128 CHAR) NOT NULL,
    AREA_ID VARCHAR2(128 CHAR) NOT NULL, BADGE_ID VARCHAR2(128 CHAR) NOT NULL, PERSON_ID VARCHAR2(128 CHAR) NOT NULL,
    COMPANY_ID VARCHAR2(128 CHAR) NOT NULL, ADMISSION_ID VARCHAR2(128 CHAR) NOT NULL, QUALIFICATION_JSON CLOB NOT NULL,
    PRESENCE_STATE VARCHAR2(16 CHAR) NOT NULL, PRESENCE_VERSION NUMBER(19, 0) NOT NULL, VERIFIED_AT TIMESTAMP(6) NOT NULL,
    EXPIRES_AT TIMESTAMP(6) NOT NULL, CONSUMED_FLAG NUMBER(1, 0) DEFAULT 0 NOT NULL, CONSUMED_EVENT_ID VARCHAR2(128 CHAR), CONSUMED_AT TIMESTAMP(6),
    CONSTRAINT PK_SCS_VERIFY PRIMARY KEY (VERIFICATION_ID), CONSTRAINT FK_SCS_VER_PRES FOREIGN KEY (PERSON_ID, AREA_ID) REFERENCES SMT_CLIENT_SUP_PRESENCE (PERSON_ID, AREA_ID),
    CONSTRAINT CK_SCS_VER_STATE CHECK (PRESENCE_STATE IN ('UNKNOWN', 'OUTSIDE', 'INSIDE')), CONSTRAINT CK_SCS_VER_VERSION CHECK (PRESENCE_VERSION >= 0),
    CONSTRAINT CK_SCS_VER_USED CHECK (CONSUMED_FLAG IN (0, 1))
);
CREATE TABLE SMT_CLIENT_SUP_EVENT (
    EVENT_ID VARCHAR2(128 CHAR) NOT NULL, VERIFICATION_ID VARCHAR2(128 CHAR) NOT NULL, OPERATOR_ID VARCHAR2(128 CHAR) NOT NULL,
    POST_ID VARCHAR2(128 CHAR) NOT NULL, AREA_ID VARCHAR2(128 CHAR) NOT NULL, DIRECTION_CODE VARCHAR2(16 CHAR) NOT NULL,
    PERSON_ID VARCHAR2(128 CHAR) NOT NULL, BADGE_ID VARCHAR2(128 CHAR) NOT NULL, COMPANY_ID VARCHAR2(128 CHAR) NOT NULL,
    ADMISSION_ID VARCHAR2(128 CHAR) NOT NULL, QUALIFICATION_JSON CLOB NOT NULL, OCCURRED_AT TIMESTAMP(6) NOT NULL, VERSION_NO NUMBER(19, 0) NOT NULL,
    CONSTRAINT PK_SCS_EVENT PRIMARY KEY (EVENT_ID), CONSTRAINT FK_SCS_EVT_VERIFY FOREIGN KEY (VERIFICATION_ID) REFERENCES SMT_CLIENT_SUP_VERIFY (VERIFICATION_ID),
    CONSTRAINT UQ_SCS_EVT_VERIFY UNIQUE (VERIFICATION_ID), CONSTRAINT UQ_SCS_EVT_VERSION UNIQUE (PERSON_ID, AREA_ID, VERSION_NO),
    CONSTRAINT CK_SCS_EVT_DIR CHECK (DIRECTION_CODE IN ('ENTER', 'LEAVE')), CONSTRAINT CK_SCS_EVT_VERSION CHECK (VERSION_NO > 0)
);
CREATE TABLE SMT_CLIENT_SUP_COMMAND (
    SCOPE_ID VARCHAR2(128 CHAR) NOT NULL, OPERATOR_ID VARCHAR2(128 CHAR) NOT NULL, IDEMPOTENCY_KEY VARCHAR2(128 CHAR) NOT NULL,
    REQUEST_HASH VARCHAR2(64 CHAR) NOT NULL, REPLY_JSON CLOB, CREATED_AT TIMESTAMP(6) NOT NULL,
    CONSTRAINT PK_SCS_COMMAND PRIMARY KEY (SCOPE_ID, OPERATOR_ID, IDEMPOTENCY_KEY)
);
