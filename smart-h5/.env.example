# Copy one of the values below into an ignored deploy file such as
# .env.production.local or .env.test.local before running pnpm build.

# Deploy environment loaded by scripts/build.mjs. Supported values:
# production, test
SMART_H5_ENV=production

# Must match the legacy H5 / gateway security.encode.key.
# This value is public in browser bundles and standalone public/config.js,
# so never commit the real value.
NEXT_PUBLIC_SECURITY_ENCODE_KEY=

# Production builds must set the gateway target used by Next rewrites.
# Use the target that can serve /auth, /app, /platform, /admin, /algorithm,
# /workbench and /file from the deployed smart-h5-next process.
API_PROXY_TARGET=http://10.0.20.113
