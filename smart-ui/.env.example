# Template of every env key the app reads. Keep real values in ignored local
# files such as .env.development, .env.production, .env.local, or
# .env.production.local. Copy keys here into those as needed.

# Backend platform + base URLs consumed by the devServer proxy (vue.config.js) in dev
# and baked into the bundle in prod. Keep real per-machine/deploy values in ignored
# files such as .env.development, .env.production, .env.local, or .env.production.local.
VUE_APP_PLATFORM_URL=http://platform.example.com
VUE_APP_BASE_URL=http://api.example.com

# Must match backend security.encode.key. This value is public in browser bundles.
# Alternatively set window.__SMART_CONFIG__.securityEncodeKey in public/config.js at deploy time.
# Keep the real value OUT of committed files: put it in .env.local / .env.production.local.
VUE_APP_SECURITY_ENCODE_KEY=
