<template>
  <view class="module-tile">
    <button class="tile-open" @click="openModule(entry.id)">
      <view class="row between tile-header">
        <view class="module-symbol" :class="entry.category == '物品放行' ? 'orange' : 'blue'">
          <AppIcon :name="entry.category == '物品放行' ? 'item-pass' : 'supplier'" size="md" />
        </view>
        <AppIcon name="chevron-right" size="sm" />
      </view>
      <text class="module-title">{{ entry.title }}</text>
      <text class="module-description">{{ entry.description }}</text>
    </button>
    <button v-if="editable" class="favorite-button" @click="toggle">
      <text class="favorite-label">{{ selected ? '已加入常用' : '加入常用' }}</text>
    </button>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import AppIcon from './AppIcon.uvue'
import { clientState, openModule, toggleFavorite, errorMessage } from '../state/session.uts'

const props = defineProps<{ entry: any; editable?: boolean }>()
const selected = computed((): boolean => clientState.favorites.includes(props.entry.id))

/** 收藏失败给出就地提示，不影响当前目录。 */
function toggle(): void {
  try {
    toggleFavorite(props.entry.id)
  } catch (error) {
    uni.showToast({ title: errorMessage(error), icon: 'none' })
  }
}
</script>

