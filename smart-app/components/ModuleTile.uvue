  width: 48%;
  margin-bottom: 14px;
  border: 1px solid #efeeee;
  border-radius: 16px;
  background-color: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.tile-open {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 142px;
  box-sizing: border-box;
  padding: 16px 14px 14px;
  margin: 0;
  border-radius: 16px 16px 0 0;
  background-color: #ffffff;
  text-align: left;
}

.tile-header {
  width: 100%;
  margin-bottom: 14px;
}

.module-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
}

.orange {
  background-color: #fff1e3;
}

.blue {
  background-color: #edf4ff;
}

.module-title {
  font-size: 15px;
  font-weight: 650;
  color: #353333;
  line-height: 24px;
}

.module-description {
  margin-top: 4px;
  font-size: 12px;
  color: #6f6c6b;
  line-height: 20px;
}

.favorite-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 42px;
  box-sizing: border-box;
  padding: 0 12px;
  margin: 0;
  border-top: 1px solid #efeeee;
  border-radius: 0 0 16px 16px;
  background-color: #ffffff;
}

.favorite-label {
  font-size: 12px;
  color: #6f6c6b;
  line-height: 20px;
}

/* #ifdef H5 */
@media (min-width: 900px) {
  .module-tile {
    width: 23.5%;
  }
}
/* #endif */
</style>
