<template>
  <ScreenFrame>
    <view class="page-intro">
      <text class="title">设置</text>
      <text class="muted page-intro-note">管理当前设备的扫码方式；安检人员还可确认本次登录使用的岗位。</text>
    </view>

    <view v-if="canConfigurePost" class="card post-setting">
      <text class="heading mb">安检岗位</text>
      <text class="label">当前岗位</text>
      <picker :range="posts" range-key="name" :value="postIndex" :disabled="posts.length == 0" @change="choosePost">
        <view class="field row between">
          <text class="text grow">{{ selectedPostName }}</text>
          <AppIcon name="chevron-down" size="sm" />
        </view>
      </picker>
      <text class="small mt">请选择设备当前所在岗位并保存。换人登录后需重新确认，现场操作页只显示此岗位。</text>
      <text v-if="posts.length == 0" class="error-text mt">当前账号没有授权岗位，请联系管理员。</text>
    </view>

    <text class="heading mb">扫码方式</text>
    <view v-for="option in options" :key="option.id" class="scan-setting card">
      <view class="row setting-head">
        <view class="icon-box" :class="option.id == 'hardware' ? '' : 'icon-box-blue'">
          <AppIcon :name="option.id == 'hardware' ? 'scan' : 'camera'" size="md" />
        </view>
        <view class="grow setting-copy">
          <view class="row between">
            <text class="heading">{{ option.title }}</text>
            <text v-if="selectedMode == option.id" class="pill pill-warm">已选择</text>
          </view>
          <text class="text setting-description">{{ option.description }}</text>
        </view>
      </view>
      <button
        class="btn setting-button"
        :class="selectedMode == option.id ? 'secondary' : ''"
        @click="choose(option.id)"
      >
        {{ selectedMode == option.id ? '已选择' : '选择此方式' }}
      </button>
    </view>

    <button class="btn primary save-button" @click="save">保存设置</button>
    <view v-if="saved" class="success save-success">
      <text class="success-text">设置已保存</text>
    </view>
    <view v-if="error.length > 0" class="error">
      <text class="error-text">{{ error }}</text>
    </view>
    <view class="note-card">
      <text class="small">此设置不关闭设备系统的实体扫码键。硬件方式需要扫码结果输入到当前编辑框。</text>
    </view>
  </ScreenFrame>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import AppIcon from '../../components/AppIcon.uvue'
import ScreenFrame from '../../components/ScreenFrame.uvue'
import { clientState, guard, setScanMode, errorMessage, canSelectExecutionPost, executionPosts, selectPost } from '../../state/session.uts'

const canConfigurePost = ref(false)
const posts = ref<any[]>([])
const selectedPost = ref('')
const postIndex = computed((): number => Math.max(0, posts.value.findIndex((post: any): boolean => post.id == selectedPost.value)))
const selectedPostName = computed((): string => posts.value.find((post: any): boolean => post.id == selectedPost.value)?.name ?? '请选择岗位')
const error = ref('')
const saved = ref(false)
const selectedMode = ref(clientState.scanMode)
const options = [
  {
    id: 'hardware',
    title: '硬件扫码头',
    description: '适用于配有扫码头的设备。选中输入框后按实体扫码键，扫描结果会自动录入。',
  },
  {
    id: 'camera',
    title: '摄像头',
    description: '适用于普通手机，也可用于有摄像头的 PDA。点击扫码按钮后打开相机识别。',
  },
]

/** 页面恢复时重新检查会话，避免退出后沿用旧界面状态。 */
onShow(() => {
  if (guard()) {
    canConfigurePost.value = canSelectExecutionPost()
    posts.value = executionPosts()
    selectedPost.value = clientState.postId
    selectedMode.value = clientState.scanMode
    saved.value = false
    error.value = ''
  }
})

/** 选择待保存的设备扫码方式，只修改当前页草稿，不提前改变生效配置。 */
function choose(mode: string): void {
  selectedMode.value = mode
  saved.value = false
  error.value = ''
}

/** 岗位选择仅更新设置草稿，显式保存后才改变现场上下文。 */
function choosePost(event: any): void {
  const post = posts.value[Number(event.detail.value)]
  if (post == null) return
  selectedPost.value = post.id
  saved.value = false
  error.value = ''
}

/** 将当前扫码方式写入设备持久存储，失败时保留原有生效配置。 */
function save(): void {
  try {
    if (!guard()) return
    if (selectedPost.value.length > 0 && (!canSelectExecutionPost() || !executionPosts().some((post: any): boolean => post.id == selectedPost.value)))
      throw new Error('该安检岗位已不可用，请重新选择')
    setScanMode(selectedMode.value)
    if (canConfigurePost.value && selectedPost.value.length > 0) selectPost(selectedPost.value)
    saved.value = true
    error.value = ''
    uni.showToast({ title: '设置已保存', icon: 'success' })
  } catch (issue) {
    saved.value = false
    error.value = errorMessage(issue)
  }
}
</script>

<style>
@import '../../styles/theme.css';

.page-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 18px;
}

.page-intro-note {
  margin-top: 4px;
}

.scan-setting {
  padding: 16px;
}

.setting-head {
  align-items: flex-start;
}

.setting-copy {
  display: flex;
  flex-direction: column;
  margin-left: 12px;
}

.setting-description {
  margin-top: 8px;
}

.setting-button {
  width: 100%;
  margin-top: 16px;
}

.save-button {
  width: 100%;
  margin-top: 4px;
}

.success {
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  padding: 12px 14px;
  margin: 10px 0;
  border-radius: 10px;
  background-color: #eaf7f1;
}

.success-text {
  color: #12754f;
  font-size: 14px;
  line-height: 22px;
}

.note-card {
  padding: 4px 2px;
}
</style>
