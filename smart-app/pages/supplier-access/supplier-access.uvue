  background-color: #fffaf5;
  border-color: #ffe2c7;
}
.no-post-error {
  margin-top: 0;
}
.scan-card {
  padding: 16px;
}
.verification-card {
  border: 1px solid #e5e3e3;
}
.verification-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 18px;
}
.status-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.status-heading {
  margin-top: 4px;
}
.status-tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 12px;
}
.status-pill {
  margin-bottom: 6px;
}
.person-hero {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}
.portrait-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 112px;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 12px;
  background-color: #f7f7f7;
}
.portrait-image {
  width: 88px;
  height: 112px;
}
.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 112px;
  padding: 8px;
  box-sizing: border-box;
}
.photo-placeholder-title {
  color: #6f6c6b;
  font-size: 14px;
  font-weight: 600;
  line-height: 22px;
}
.photo-placeholder-note {
  margin-top: 4px;
  text-align: center;
}
.person-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 14px;
  padding-top: 2px;
}
.person-name {
  font-size: 24px;
  line-height: 34px;
  font-weight: 700;
  color: #353333;
}
.company-label {
  margin-top: 16px;
  margin-bottom: 2px;
}
.company-name {
  color: #595757;
  font-size: 16px;
  line-height: 24px;
}
.info-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 18px;
}
.info-section-title {
  margin-bottom: 10px;
  color: #353333;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
}
.info-line {
  display: flex;
  flex-direction: row;
  margin-bottom: 10px;
  align-items: flex-start;
}
.info-label {
  width: 104px;
  flex-shrink: 0;
  margin-right: 12px;
  padding-top: 2px;
}
.info-value {
  flex: 1;
  min-width: 0;
  color: #595757;
  font-size: 15px;
  line-height: 24px;
}
.area-values {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.area-value {
  margin-bottom: 6px;
}
.passage-section {
  display: flex;
  flex-direction: column;
}
.passage-actions {
  display: flex;
  flex-direction: row;
  margin-top: 18px;
}
.passage-button {
  flex: 1;
  min-height: 48px;
  padding: 0 10px;
}
.passage-next {
  margin-left: 14px;
}
.success-panel {
  background-color: #edf8f3;
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 14px;
}
.success-title {
  color: #14724d;
  font-size: 19px;
  font-weight: 700;
  line-height: 28px;
}
.demo-reference {
  padding: 10px 4px;
}
/* #ifdef H5 */
.person-name { word-break: break-all; }
.company-name { word-break: break-all; }
.info-value { word-break: break-all; }
/* #endif */
</style>
