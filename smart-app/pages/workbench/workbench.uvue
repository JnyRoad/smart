<template>
  <ScreenFrame>
    <view v-if="clientState.identity != null">
      <view class="workbench-top row">
        <image src="/static/yuto-logo.png" mode="aspectFit" class="work-logo" />
      </view>

      <view class="welcome-block">
        <text class="title">{{ clientState.identity.displayName }}，你好</text>
        <text class="muted welcome-meta">{{ employmentLabel() }} · {{ clientState.identity.organization }}</text>
      </view>

      <view class="task-spotlight card-warm">
        <view class="task-copy grow">
          <text class="spotlight-title">今天的协作，从这里开始</text>
          <text class="muted spotlight-note">申请进度与待处理事项，及时掌握</text>
        </view>
        <button class="task-count-button" @click="openTodos">
          <text class="task-count">{{ todoCount }}</text>
          <text class="small task-count-label">待处理</text>
        </button>
      </view>

      <view class="section-head">
        <view>
          <text class="heading">常用应用</text>
          <text class="muted section-subtitle">按权限显示可操作功能</text>
        </view>
        <button class="link" @click="openApps">全部应用</button>
      </view>
      <view class="module-grid row wrap">
        <ModuleTile v-for="entry in favoriteEntries" :key="entry.id" :entry="entry" />
      </view>
      <view v-if="favoriteEntries.length == 0" class="card empty">
        <view class="icon-box icon-box-gray empty-icon"><AppIcon name="settings" size="md" /></view>
        <text class="text empty-title">暂无常用应用</text>
        <text class="muted empty-note">前往全部应用添加已授权功能。</text>
        <button class="btn secondary empty-button" @click="openApps">浏览全部应用</button>
      </view>

      <view class="section-head">
        <view>
          <text class="heading">最近申请</text>
          <text class="muted section-subtitle">查看当前账号最近提交的单据</text>
        </view>
        <button class="link" :disabled="clientState.loading" @click="refresh">刷新</button>
      </view>
      <view v-if="clientState.loading" class="card loading-card">
        <text class="muted">正在加载申请记录…</text>
      </view>
      <view v-if="clientState.error.length > 0" class="error">
        <text class="error-text">{{ clientState.error }}</text>
      </view>
      <button v-for="item in recent" :key="item.id" class="record-row" @click="openDetail(item.id)">
        <view class="row record-main">
          <view class="icon-box" :class="item.kind == 'item-pass' ? '' : 'icon-box-blue'">
            <AppIcon :name="item.kind == 'item-pass' ? 'item-pass' : 'supplier'" size="md" />
          </view>
          <view class="grow record-copy">
            <view class="row between">
              <text class="text record-title">{{ item.title }}</text>
              <StatusBadge :status="item.status" />
            </view>
            <text class="small record-meta">{{ item.kind == 'item-pass' ? '物品放行' : '保密区通行' }} · {{ item.applicantName }}</text>
          </view>
          <AppIcon name="chevron-right" size="sm" />
        </view>
      </button>
      <view v-if="recent.length == 0 && !clientState.loading" class="card empty">
        <text class="text">暂无申请记录</text>
        <text class="muted empty-note">新的申请提交后会出现在这里。</text>
      </view>
    </view>
  </ScreenFrame>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import AppIcon from '../../components/AppIcon.uvue'
import ScreenFrame from '../../components/ScreenFrame.uvue'
import ModuleTile from '../../components/ModuleTile.uvue'
import StatusBadge from '../../components/StatusBadge.uvue'
import {
  clientState,
  guard,
	loadAuthorizedApps,
  loadWorkbenchApplications,
  favorites,
  todos,
} from '../../state/session.uts'

const favoriteEntries = computed((): any[] => favorites())
const todoCount = computed((): number => todos().length)
const recent = computed((): any[] =>
  clientState.applications
    .filter((item: any): boolean => item.applicantId == clientState.identity?.subjectId)
    .slice(0, 3),
)

/** 将服务端身份类别映射为统一展示文案，不参与权限判断。 */
function employmentLabel(): string {
  const type = clientState.identity == null ? '' : clientState.identity.employmentType
  return type == 'employee' ? '正式员工' : '外包／派遣人员'
}

/** 页面再次出现时重新确认会话并加载当前授权数据。 */
onShow(async () => {
	if (guard()) {
		await loadAuthorizedApps()
		await loadWorkbenchApplications()
	}
})

/** 打开完整应用目录，保留当前工作台状态。 */
function openApps(): void {
  uni.navigateTo({ url: '/pages/apps/apps' })
}

/** 切换到待办页，沿用当前账号授权。 */
function openTodos(): void {
  uni.switchTab({ url: '/pages/todos/todos' })
}

/** 打开当前可见单据，详情页将再次校验会话。 */
function openDetail(id: string): void {
  uni.navigateTo({ url: '/pages/detail/detail?id=' + encodeURIComponent(id) + '&view=read' })
}

/** 刷新当前账号可见的记录，错误由会话层显示。 */
async function refresh(): Promise<void> {
  await loadWorkbenchApplications()
}
</script>

<style>
@import '../../styles/theme.css';

.workbench-top {
  align-items: center;
  margin-bottom: 24px;
}

.work-logo {
  width: 112px;
  height: 22px;
}

.welcome-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 18px;
}

.welcome-meta {
  margin-top: 4px;
}

.task-spotlight {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18px;
  margin-bottom: 0;
  border-radius: 16px;
}

.spotlight-title {
  color: #5a2600;
  font-size: 17px;
  font-weight: 650;
  line-height: 26px;
}

.spotlight-note {
  margin-top: 4px;
  color: #7f624d;
}

.task-count-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  min-height: 64px;
  padding: 0 8px;
  margin: 0 0 0 12px;
  border-radius: 12px;
  background-color: #ffffff;
}

.task-count {
  color: #b55100;
  font-size: 32px;
  font-weight: 700;
  line-height: 36px;
}

.task-count-label {
  color: #7f624d;
}

.section-subtitle {
  margin-top: 2px;
}

.module-grid {
  width: 100%;
  align-items: stretch;
  justify-content: space-between;
}

.empty-icon {
  margin-bottom: 12px;
}

.empty-title {
  font-weight: 600;
}

.empty-note {
  margin-top: 4px;
}

.empty-button {
  min-width: 132px;
  margin-top: 18px;
}

.loading-card {
  padding-top: 18px;
  padding-bottom: 18px;
}

.record-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  box-sizing: border-box;
  padding: 14px;
  margin: 0 0 10px;
  border: 1px solid #efeeee;
  border-radius: 14px;
  background-color: #ffffff;
  text-align: left;
}

.record-main {
  width: 100%;
  min-width: 0;
}

.record-copy {
  margin: 0 12px;
}

.record-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-meta {
  margin-top: 5px;
}

/* #ifdef H5 */
@media (min-width: 900px) {
  .task-spotlight {
    max-width: 620px;
  }
}
/* #endif */
</style>
