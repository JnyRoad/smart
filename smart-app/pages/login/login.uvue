  display: flex;
  flex-direction: column;
  margin-bottom: 24px;
}

.login-intro {
  margin-top: 4px;
}

.login-button {
  width: 100%;
}

.login-help {
  margin-top: 12px;
}

.demo-area {
  margin-top: 24px;
  border-top: 1px solid #efeeee;
}

.demo-toggle {
  align-self: flex-start;
  padding-left: 0;
  padding-right: 0;
}

.demo-list {
  display: flex;
  flex-direction: column;
}

.demo-tip {
  margin-bottom: 8px;
}

.demo-account {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 52px;
  box-sizing: border-box;
  padding: 8px 12px;
  margin: 0 0 8px;
  border: 1px solid #efeeee;
  border-radius: 10px;
  background-color: #ffffff;
  text-align: left;
}

.demo-copy {
  display: flex;
  flex-direction: column;
}

.company {
  margin-top: 24px;
  text-align: center;
  color: #6f6c6b;
  font-size: 12px;
  line-height: 20px;
}

/* #ifdef H5 */
@media (min-width: 900px) {
  .login-page {
    flex-direction: row;
    min-height: 100vh;
  }

  .brand-board {
    width: 54%;
    height: auto;
    min-height: 100vh;
  }

  .brand-copy {
    padding: 64px;
  }

  .login-title {
    margin-top: 72px;
    font-size: 48px;
    line-height: 58px;
  }

  .login-subtitle {
    margin-top: 8px;
    font-size: 20px;
    line-height: 30px;
  }

  .brand-note {
    max-width: 320px;
    font-size: 15px;
  }

  .login-panel {
