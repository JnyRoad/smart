  max-width: 240px;
  margin-top: 10px;
  font-size: 13px;
  color: #6f6c6b;
  line-height: 22px;
}

.login-panel {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 26px 24px 34px;
  background-color: #ffffff;
}

