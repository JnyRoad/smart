/** uni平台传输只负责一次HTTP调用；不重试写入，不记录请求正文和认证头。 */
import { runtimeConfig } from '../config/runtime.uts'

/** 执行受超时限制的请求，将网络故障转换为用户可理解的错误。 */
export function uniTransport(request: any): Promise<any> {
  return new Promise((resolve, reject) => {
    uni.request({
      url: request.url,
      method: request.method,
      header: request.headers,
      data: request.body,
      timeout: runtimeConfig.requestTimeout,
      success: (response) => resolve({ status: response.statusCode, body: response.data }),
      fail: () =>
        reject(new Error('网络连接失败；提交结果可能尚未返回，请先查看记录再决定是否重试')),
    })
  })
}
