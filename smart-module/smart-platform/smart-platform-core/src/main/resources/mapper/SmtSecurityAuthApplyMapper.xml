<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tce.smart.platform.core.mapper.SmtSecurityAuthApplyMapper">

	<resultMap id="smtSecurityAuthApplyMap" type="com.tce.smart.platform.core.entity.securityzone.SmtSecurityAuthApply">
		<id property="id" column="ID"/>
		<result property="serialNum" column="SERIAL_NUM"/>
		<result property="processId" column="PROCESS_ID"/>
		<result property="createTime" column="CREATE_TIME"/>
		<result property="oaStatus" column="OA_STATUS"/>
		<result property="deviceStatus" column="DEVICE_STATUS"/>
		<result property="totalNum" column="TOTAL_NUM"/>
		<result property="successNum" column="SUCCESS_NUM"/>
		<result property="areaId" column="AREA_ID"/>
		<result property="areaName" column="AREA_NAME"/>
		<result property="remark" column="REMARK"/>
		<result property="parkId" column="PARK_ID"/>
	</resultMap>


	<select id="getPage" parameterType="com.tce.smart.platform.core.ao.SecurityAuthApplyPageQueryAO"
			resultType="com.tce.smart.platform.api.dto.resp.securityzone.SecurityAuthApplyPageRespDTO">
		select SA.*，ST.NAME,ST.BADGE,ST.JOB_NAME,ST.COMP_NAME,ST.DEP_NAME
		from SMT_SECURITY_AUTH_APPLY SA
		inner join SMT_STAFF ST ON SA.APPLY_BADGE = ST.BADGE
		<where>
			<if test="query.processId !=null and query.processId !='' ">
				AND SA.PROCESS_ID LIKE CONCAT(CONCAT('%',#{query.processId}),'%')
			</if>
			<if test="query.buId!=null and  query.buId!='' ">
				AND ST.COMP_ID =  #{query.buId}
			</if>
			<if test="query.depId!=null and  query.depId!='' ">
				AND ST.DEP_ID = #{query.depId}
			</if>
			<if test="query.parkId!=null and  query.parkId!='' ">
				AND SA.PARK_ID = #{query.parkId}
			</if>
			<if test="query.downStatus!=null and  query.downStatus!='' ">
				AND SA.DEVICE_STATUS =  #{query.downStatus}
			</if>
			<if test="query.startDate != null and query.startDate != ''">
				AND (TO_DATE(to_Char(SA.CREATE_TIME,'yyyy-MM-dd hh24:mi:ss'),'yyyy-MM-dd hh24:mi:ss')
				between to_date(#{query.startDate},'yyyy-MM-dd hh24:mi:ss') and to_date(#{query.endDate},'yyyy-MM-dd hh24:mi:ss'))
			</if>
			<if test="query.parkIds!=null and  query.parkIds.size>0">
				and SA.PARK_ID in
				<foreach item="item" index="index" collection="query.parkIds" open="(" separator="," close=")">
					#{item}
				</foreach>
			</if>
		</where>
		order by SA.CREATE_TIME desc
	</select>
</mapper>
