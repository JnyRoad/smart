<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>smart-platform-biz</artifactId>
	<packaging>jar</packaging>

	<name>smart-platform-biz</name>
	<description>智慧园区平台服务</description>

	<parent>
		<groupId>com.tce</groupId>
		<artifactId>smart-platform</artifactId>
		<version>${revision}</version>
	</parent>

	<dependencies>
		<!--push api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-push-api</artifactId>
		</dependency>

		<!--platform api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-platform-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-platform-core</artifactId>
		</dependency>

		<!--bridge api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-bridge-api</artifactId>
		</dependency>

		<!--data api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-data-api</artifactId>
		</dependency>

		<!--app api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-app-api</artifactId>
		</dependency>
		<!--smart-upms api、vo 模块-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-upms-api</artifactId>
		</dependency>
		<!-- 集合工具 模块-->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>25.0-jre</version>
		</dependency>

		<!--日志处理-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-common-log</artifactId>
		</dependency>
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-common-data</artifactId>
		</dependency>
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-common-security</artifactId>
		</dependency>
		<!--web 模块-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--undertow容器-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-undertow</artifactId>
		</dependency>
		<!--导入导出工具类-->
		<dependency>
			<groupId>cn.afterturn</groupId>
			<artifactId>easypoi-base</artifactId>
			<version>4.1.3</version>
		</dependency>
		<!--数据库-->
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>oracle</artifactId>
			<version>2.0</version>

		</dependency>
		<!-- alibaba的druid数据库连接池 -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>druid-spring-boot-starter</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.belerweb/pinyin4j -->
		<dependency>
			<groupId>com.belerweb</groupId>
			<artifactId>pinyin4j</artifactId>
			<version>2.5.0</version>
		</dependency>
		<!--IDEA开发工具,热加载调试用-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>springloaded</artifactId>
			<version>1.2.8.RELEASE</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-dispatcher-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.tce</groupId>
			<artifactId>smart-algorithm-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>3.3.3</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.3.3</version>
		</dependency>
		<dependency>
			<groupId>jcifs</groupId>
			<artifactId>jcifs</artifactId>
			<version>1.3.17</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<version>2.1.3.RELEASE</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
		</dependency>
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>fastjson</artifactId>
			<!--<version>1.2.13</version>-->
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>net.sf.json-lib</groupId>
			<artifactId>json-lib</artifactId>
			<version>2.2.3</version>
			<classifier>jdk15</classifier>
		</dependency>

		<!-- websocket -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<skip>false</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>2.2.5.RELEASE</version>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<includeSystemScope>true</includeSystemScope>
					<mainClass>com.tce.smart.platform.SmartPlatformApplication</mainClass>
					<fork>true</fork>
					<addResources>true</addResources>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
