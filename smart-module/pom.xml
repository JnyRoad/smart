<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.tce</groupId>
		<artifactId>smart</artifactId>
		<!--与同仓 smart 父工程使用一致的 CI 友好版本，支持干净本地仓库解析。-->
		<version>${revision}</version>
		<relativePath>../smart/pom.xml</relativePath>
	</parent>

	<artifactId>smart-module</artifactId>
	<version>${revision}</version>

	<description>业务模块</description>
	<packaging>pom</packaging>
	<modules>
		<module>FileReceiver</module>
		<module>smart-tool</module>
		<module>smart-data</module>
		<module>smart-platform</module>
		<module>smart-app</module>
		<module>smart-schedule</module>
		<module>smart-push</module>
		<module>smart-dispatcher</module>
		<module>smart-bridge</module>
		<module>smart-bridge-concentrator</module>
		<module>smart-bridge-isc</module>
		<module>smart-algorithm</module>
		<module>smart-file</module>
		<module>smart-transfer</module>
        <module>smart-park-service</module>
        <module>smart-data/smart-xcvehicle-core</module>
	</modules>

	<properties>
		<revision>3.0.1-SNAPSHOT</revision>
		<tool.version>${revision}</tool.version>
		<smart.version>${revision}</smart.version>
		<jackson.modules>2.9.6</jackson.modules>
		<!--<mybatis-plus.version>3.1.0</mybatis-plus.version>-->
		<mybatis-plus.version>3.4.1</mybatis-plus.version>
		<mybatis.version>3.5.6</mybatis.version>
		<mysql.connector.version>8.0.13</mysql.connector.version>
		<oracle.connector.version>2.0</oracle.connector.version>
		<icbc.api.sdk.version>1.0</icbc.api.sdk.version>
		<!--<druid.version>1.1.21</druid.version>-->
		<druid.version>1.2.15</druid.version>
		<shedlock.version>2.2.0</shedlock.version>
		<!-- logback 版本，兼容 Java 8 -->
		<!--<logback.version>1.2.12</logback.version>-->
		<logback.version>1.2.3</logback.version>
		<!-- 其他常用依赖版本 -->
		<gson.version>2.8.9</gson.version>
		<commons-codec.version>1.15</commons-codec.version>
		<!-- 网络和数据库相关 -->
		<netty.version>4.1.33.Final</netty.version>
		<!-- Web服务相关 -->
		<axis.version>1.4</axis.version>
		<commons-discovery.version>0.2</commons-discovery.version>
		<commons-beanutils.version>1.8.0</commons-beanutils.version>
		<!-- 开发工具 -->
		<springloaded.version>1.2.8.RELEASE</springloaded.version>
		<!-- 图片处理 -->
		<thumbnailator.version>0.4.8</thumbnailator.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>smart-common-bom</artifactId>
				<version>${revision}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-platform-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-platform-core</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-dispatcher-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
