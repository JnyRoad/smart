			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-app-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-push-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
