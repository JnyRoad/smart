			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-guard-core</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-ehrview-core</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-consume-core</artifactId>
