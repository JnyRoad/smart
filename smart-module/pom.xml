				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-bridge-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
				<artifactId>smart-bridge-isc-api</artifactId>
				<version>${smart.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tce</groupId>
