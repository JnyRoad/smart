    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        Badge, Name, CompID, compname, depid, depname, jobid, jobname, ReportTo,
        Status, statusName, EmpType, emptypeName,
        JchenID, JchenName, FLCJ, joindate, LeaDate, age,
        BirthDay, certno, Gender, genderName, mobile, TEL, EMAIL, EMERGENCYNAME,
        RELATION, relationName, TELEPHONE, altertime,
        ezid,EID,userid,PZID,e_salarytype,salarytypename,isblacklist
    </sql>

	<select id="getPage" resultType="com.tce.smart.ehrview.core.entity.EvwEmphrYs">
		SELECT e.Badge, e.Name, e.CompID, e.compname, e.depid, e.depname, e.jobid, e.jobname, e.ReportTo,
		e.Status, e.statusName, e.EmpType, e.emptypeName,
		e.JchenID, e.JchenName, e.FLCJ, e.joindate, e.LeaDate, e.age,
		e.BirthDay, e.certno, e.Gender, e.genderName, e.mobile, e.TEL, EMAIL, e.EMERGENCYNAME,
		e.RELATION, e.relationName, e.TELEPHONE, e.altertime,e.residentaddress,e.nation,
		e.ezid,e.EID,e.userid,e.PZID,e.e_salarytype,e.salarytypename,e.isblacklist,o.depAbbr
		FROM evw_empHR_ys e
		LEFT JOIN ovw_YsDep o ON e. depid = o. depid
		<where>
			<if test="compId !=null and compId.size>0">
				and e.CompID in
				<foreach item="item" index="index" collection="compId" open="(" separator="," close=")">
					#{item}
				</foreach>
			</if>
		</where>
		ORDER BY e.altertime desc
	</select>
</mapper>
