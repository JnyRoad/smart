        <result column="Badge" property="Badge" />
        <result column="Name" property="Name" />
        <result column="CompID" property="CompID" />
        <result column="compname" property="compname" />
        <result column="depid" property="depid" />
        <result column="depname" property="depname" />
        <result column="jobid" property="jobid" />
        <result column="jobname" property="jobname" />
        <result column="ReportTo" property="ReportTo" />
        <result column="Status" property="Status" />
        <result column="statusName" property="statusName" />
        <result column="EmpType" property="EmpType" />
        <result column="emptypeName" property="emptypeName" />
        <result column="JchenID" property="JchenID" />
        <result column="JchenName" property="JchenName" />
        <result column="FLCJ" property="flcj" />
        <result column="joindate" property="joindate" />
        <result column="LeaDate" property="LeaDate" />
        <result column="age" property="age" />
        <result column="BirthDay" property="BirthDay" />
        <result column="certno" property="certno" />
        <result column="Gender" property="Gender" />
        <result column="genderName" property="genderName" />
        <result column="mobile" property="mobile" />
        <result column="TEL" property="tel" />
        <result column="EMAIL" property="email" />
