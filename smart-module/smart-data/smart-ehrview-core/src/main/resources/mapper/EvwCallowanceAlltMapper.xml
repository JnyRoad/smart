<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tce.smart.ehrview.core.mapper.EvwCallowanceAlltMapper">

	<!-- 通用查询映射结果 -->
	<resultMap id="BaseResultMap" type="com.tce.smart.ehrview.core.entity.EvwCallowanceAllt">
		<result column="BADGE" property="BADGE" />
		<result column="NAME" property="NAME" />
		<result column="DEPID" property="DEPID" />
		<result column="XTYPE" property="XTYPE" />
		<result column="BEGINDATE" property="BEGINDATE" />
		<result column="APPENDDATE" property="APPENDDATE" />
		<result column="AMOUNT" property="AMOUNT" />
		<result column="Explain" property="Explain" />
	</resultMap>

	<!-- 通用查询结果列 -->
	<sql id="Base_Column_List">
        BADGE, NAME, DEPID, XTYPE, BEGINDATE, APPENDDATE, AMOUNT, Explain
    </sql>

	<select id="list" resultMap="BaseResultMap">
		SELECT <include refid="Base_Column_List"></include>
		FROM evw_CALLOWANCE_allt
		WHERE evw_CALLOWANCE_allt.BADGE = #{badge, jdbcType = VARCHAR}
		<if test="queryMonth != null and queryMonth != ''">
			AND CONVERT(VarChar(7), evw_CALLOWANCE_allt.BEGINDATE, 120) = #{ queryMonth, jdbcType = VARCHAR }
		</if>
		ORDER BY evw_CALLOWANCE_allt.BEGINDATE
	</select>
</mapper>
