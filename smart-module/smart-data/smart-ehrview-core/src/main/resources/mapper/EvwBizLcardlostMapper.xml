<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tce.smart.ehrview.core.mapper.EvwBizLcardlostMapper">

	<!-- 通用查询映射结果 -->
	<resultMap id="BaseResultMap" type="com.tce.smart.ehrview.core.entity.EvwBizLcardlost">
		<result column="BADGE" property="BADGE" />
		<result column="NAME" property="NAME" />
		<result column="KQSTARTDATE" property="KQSTARTDATE" />
		<result column="REASON" property="REASON" />
		<result column="SHIFT" property="SHIFT" />
		<result column="DEPID" property="DEPID" />
		<result column="FormState" property="FormState" />
	</resultMap>

	<!-- 通用查询结果列 -->
	<sql id="Base_Column_List">
        BADGE, NAME, KQSTARTDATE, DEPID, REASON, SHIFT, FormState
    </sql>

	<select id="list" resultMap="BaseResultMap">
		SELECT <include refid="Base_Column_List"></include>
		FROM evw_BIZ_LCARDLOST
		WHERE evw_BIZ_LCARDLOST.BADGE = #{badge, jdbcType = VARCHAR}
		<if test="queryMonth != null and queryMonth != ''">
			AND CONVERT(VarChar(7), evw_BIZ_LCARDLOST.KQSTARTDATE, 120) = #{ queryMonth, jdbcType = VARCHAR }
		</if>
		ORDER BY evw_BIZ_LCARDLOST.KQSTARTDATE
	</select>
</mapper>
