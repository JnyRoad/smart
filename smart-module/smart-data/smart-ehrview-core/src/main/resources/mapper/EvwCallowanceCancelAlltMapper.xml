<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tce.smart.ehrview.core.mapper.EvwCallowanceCancelAlltMapper">

	<!-- 通用查询映射结果 -->
	<resultMap id="BaseResultMap" type="com.tce.smart.ehrview.core.entity.EvwCallowanceCancelAllt">
		<result column="BADGE" property="BADGE" />
		<result column="NAME" property="NAME" />
		<result column="DEPID" property="DEPID" />
		<result column="XTYPE" property="XTYPE" />
		<result column="BACKDATE" property="BACKDATE" />
		<result column="AMOUNT" property="AMOUNT" />
		<result column="REAMRK" property="REAMRK" />
	</resultMap>

	<!-- 通用查询结果列 -->
	<sql id="Base_Column_List">
        BADGE, NAME, XTYPE, DEPID, BACKDATE, AMOUNT, REAMRK
    </sql>

	<select id="list" resultMap="BaseResultMap">
		SELECT <include refid="Base_Column_List"></include>
		FROM evw_CALLOWANCE_cancel_allt
		WHERE evw_CALLOWANCE_cancel_allt.BADGE = #{badge, jdbcType = VARCHAR}
		<if test="queryMonth != null and queryMonth != ''">
			AND CONVERT(VarChar(7), evw_CALLOWANCE_cancel_allt.BACKDATE, 120) = #{ queryMonth, jdbcType = VARCHAR }
		</if>
		ORDER BY evw_CALLOWANCE_cancel_allt.BACKDATE
	</select>
</mapper>
