<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tce.smart.businesstrip.core.mapper.VWorkflowSelectitemMapper">

	<select id="getList" resultType="com.tce.smart.businesstrip.core.entity.VWorkflowSelectitem">

		select ID,FIELDID,SELECTVALUE,SELECTNAME,CANCEL
		FROM ECOLOGY.V_WORKFLOW_SELECTITEM
		<where>
			cancel = 0 and fieldid = #{fieldId}
			<if test="selectIdList!=null and selectIdList.size>0">
				and SELECTVALUE in
				<foreach item="item" index="index" collection="selectIdList" open="(" separator="," close=")">
					#{item}
				</foreach>
			</if>
		</where>
	</select>
</mapper>
