<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tce.smart.businesstrip.core.mapper.FormTableMain182Mapper">

	<select id="getByRequestId" resultType="com.tce.smart.businesstrip.core.entity.FormTableMain182">
		select *
		FROM ECOLOGY.FORMTABLE_MAIN_182
		<where>
			1=1 and REQUESTID = #{requestId}
		</where>
	</select>
</mapper>
