<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tce.smart.app.mapper.AppSubjectModuleMapper">

	<resultMap id="appSubjectModuleMap" type="com.tce.smart.app.entity.AppSubjectModule">
		<id property="id" column="id"/>
		<result property="subjectId" column="subject_id"/>
		<result property="moduleId" column="module_id"/>
	</resultMap>

	<delete id="deleteModule">
		delete  from  APP_SUBJECT_MODULE  where subject_id = #{id}
	</delete>
</mapper>
