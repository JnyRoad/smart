<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tce.smart.app.mapper.AppSubjectContentPictureMapper">

  <resultMap id="appSubjectContentPictureMap" type="com.tce.smart.app.entity.AppSubjectContentPicture">
                  <id property="id" column="id"/>
                        <result property="subjectId" column="subject_id"/>
                        <result property="contentPictureId" column="content_picture_id"/>
            </resultMap>
	<insert id="addBootPicSubject" parameterType="com.tce.smart.app.entity.AppSubjectContentPicture">
		insert into APP_SUBJECT_CONTENT_PICTURE values (#{app.id},#{app.subjectId},#{app.contentPictureId})
	</insert>
</mapper>
